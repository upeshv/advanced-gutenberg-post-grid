# This file is for unifying the coding style for different editors and IDEs
# editorconfig.org

root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

# Modern JS / React / Block Standards (Spaces)
[*.{js,jsx,ts,tsx,json}]
indent_style = space
indent_size = 2

# CI/CD & Configs: YAML strictly requires spaces (Tabs will break pipelines)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# WordPress PHP Core Standard (Tabs)
[*.php]
indent_style = tab

# SCSS / CSS (Gutenberg Prettier Standard)
[*.{css,scss}]
indent_style = space
indent_size = 2

# Markdown formatting
[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2