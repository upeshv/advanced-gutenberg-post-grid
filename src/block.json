{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "advanced-post-grid/grid",
    "version": "1.0.0",
    "title": "Advanced Post Grid",
    "category": "widgets",
    "icon": "grid-view",
    "description": "A dynamic React-powered post grid for enterprise filtering.",
    "keywords": ["posts", "grid", "query"],
    "textdomain": "advanced-post-grid",
    "example": {
        "attributes": {
            "postCount": 3,
            "columns": 3,
            "displayImage": true
        }
    },
    "supports": {
        "html": false,
        "align": ["wide", "full"],
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "attributes": {
        "postCount": {
            "type": "number",
            "default": 3,
            "minimum": 1,
            "maximum": 100
        },
        "columns": {
            "type": "number",
            "default": 3,
            "minimum": 1,
            "maximum": 6
        },
        "categoryId": {
            "type": "number",
            "default": 0
        },
        "orderBy": {
            "type": "string",
            "default": "date",
            "enum": ["date", "title", "menu_order", "rand"]
        },
        "order": {
            "type": "string",
            "default": "desc",
            "enum": ["asc", "desc"]
        },
        "displayImage": {
            "type": "boolean",
            "default": true
        }
    },
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css",
    "render": "file:./render.php"
}